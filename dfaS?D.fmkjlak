[32m+[m
[32m+[m[32masync function askGpt(event) {[m
[32m+[m	[32mconst response = await axios({[m
[32m+[m		[32murl: "https://api.openai.com/v1/chat/completions",[m
[32m+[m		[32mmethod: "POST",[m
[32m+[m		[32mheaders: {[m
[32m+[m			[32m"Authorization": `Bearer ${apiKey}`,[m
[32m+[m			[32m"Content-Type": "application/json"[m
[32m+[m		[32m},[m
[32m+[m		[32mdata: {[m
[32m+[m			[32mmodel: "gpt-3.5-turbo",[m
[32m+[m			[32mmessages: openAIHistory[event.senderID],[m
[32m+[m			[32mmax_tokens: maxTokens,[m
[32m+[m			[32mtemperature: 0.7[m
[32m+[m		[32m}[m
[32m+[m	[32m});[m
[32m+[m	[32mreturn response;[m
[32m+[m[32m}[m
[32m+[m
[32m+[m[32masync function handleGpt(event, message, args, getLang, commandName) {[m
[32m+[m	[32mtry {[m
[32m+[m		[32mopenAIUsing[event.senderID] = true;[m
[32m+[m
[32m+[m		[32mif ([m
[32m+[m			[32m!openAIHistory[event.senderID] ||[m
[32m+[m			[32m!Array.isArray(openAIHistory[event.senderID])[m
[32m+[m		[32m)[m
[32m+[m			[32mopenAIHistory[event.senderID] = [];[m
[32m+[m
[32m+[m		[32mif (openAIHistory[event.senderID].length >= maxStorageMessage)[m
[32m+[m			[32mopenAIHistory[event.senderID].shift();[m
[32m+[m
[32m+[m		[32mopenAIHistory[event.senderID].push({[m
[32m+[m			[32mrole: 'user',[m
[32m+[m			[32mcontent: args.join(' ')[m
[32m+[m		[32m});[m
[32m+[m
[32m+[m		[32mconst response = await askGpt(event);[m
[32m+[m		[32mconst text = response.data.choices[0].message.content;[m
[32m+[m
[32m+[m		[32mopenAIHistory[event.senderID].push({[m
[32m+[m			[32mrole: 'assistant',[m
[32m+[m			[32mcontent: text[m
[32m+[m		[32m});[m
[32m+[m
[32m+[m		[32mreturn message.reply(text, (err, info) => {[m
[32m+[m			[32mglobal.GoatBot.onReply.set(info.messageID, {[m
[32m+[m				[32mcommandName,[m
[32m+[m				[32mauthor: event.senderID,[m
[32m+[m				[32mmessageID: info.messageID[m
[32m+[m			[32m});[m
[32m+[m		[32m});[m
[32m+[m	[32m}[m
[32m+[m	[32mcatch (err) {[m
[32m+[m		[32mconst errorMessage = err.response?.data.error.message || err.message || "";[m
[32m+[m		[32mreturn message.reply(getLang('error', errorMessage));[m
[32m+[m	[32m}[m
[32m+[m	[32mfinally {[m
[32m+[m		[32mdelete openAIUsing[event.senderID];[m
[32m+[m	[32m}[m
[32m+[m[32m      }[m[41m [m
