[32m+[m					[32mreturn message.reply(getLang('invalidContentDraw'));[m
[32m+[m				[32mif (openAIUsing[event.senderID])[m
[32m+[m					[32mreturn message.reply(getLang("yourAreUsing"));[m
[32m+[m
[32m+[m				[32mopenAIUsing[event.senderID] = true;[m
[32m+[m
[32m+[m				[32mlet sending;[m
[32m+[m				[32mtry {[m
[32m+[m					[32msending = message.reply(getLang('processingRequest'));[m
[32m+[m					[32mconst responseImage = await axios({[m
[32m+[m						[32murl: "https://api.openai.com/v1/images/generations",[m
[32m+[m						[32mmethod: "POST",[m
[32m+[m						[32mheaders: {[m
[32m+[m							[32m"Authorization": `Bearer ${apiKey}`,[m
[32m+[m							[32m"Content-Type": "application/json"[m
[32m+[m						[32m},[m
[32m+[m						[32mdata: {[m
[32m+[m							[32mprompt: args.slice(1).join(' '),[m
[32m+[m							[32mn: numberGenerateImage,[m
[32m+[m							[32msize: '1024x1024'[m
[32m+[m						[32m}[m
[32m+[m					[32m});[m
[32m+[m					[32mconst imageUrls = responseImage.data.data;[m
[32m+[m					[32mconst images = await Promise.all(imageUrls.map(async (item) => {[m
[32m+[m						[32mconst image = await axios.get(item.url, {[m
[32m+[m							[32mresponseType: 'stream'[m
[32m+[m						[32m});[m
[32m+[m						[32mimage.data.path = `${Date.now()}.png`;[m
[32m+[m						[32mreturn image.data;[m
[32m+[m					[32m}));[m
[32m+[m					[32mreturn message.reply({[m
[32m+[m						[32mattachment: images[m
[32m+[m					[32m});[m
[32m+[m				[32m}[m
[32m+[m				[32mcatch (err) {[m
