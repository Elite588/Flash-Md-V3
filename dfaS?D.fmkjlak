[32m+[m					[32mreturn message.reply(getLang('error', errorMessage || ''));[m
[32m+[m				[32m}[m
[32m+[m				[32mfinally {[m
[32m+[m					[32mdelete openAIUsing[event.senderID];[m
[32m+[m					[32mmessage.unsend((await sending).messageID);[m
[32m+[m				[32m}[m
[32m+[m			[32m}[m
[32m+[m			[32mcase 'clear': {[m
